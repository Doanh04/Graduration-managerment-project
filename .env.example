# Sao chép thành .env trên server và thay toàn bộ giá trị CHANGE_ME.
# Không commit file .env thật lên Git.

MYSQL_DATABASE=graduration-managerment
MYSQL_USER=graduration_app
MYSQL_PASSWORD=CHANGE_ME_MYSQL_APP_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD

MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=CHANGE_ME_MONGO_ROOT_PASSWORD
# Mật khẩu trong URI phải URL-encode: @ -> %40, # -> %23, / -> %2F.
MONGO_URI=mongodb://admin:CHANGE_ME_MONGO_ROOT_PASSWORD@mongodb:27017/graduration_managerment?authSource=admin

# Khóa HMAC Base64 tối thiểu 32 byte. Có thể tạo bằng: openssl rand -base64 48
JWT_SIGNER_KEY=CHANGE_ME_BASE64_JWT_SIGNER_KEY
JWT_VALID_DURATION=3600
JWT_REFRESHABLE_DURATION=36000

# Public trực tiếp: 80. Nếu có Nginx/Caddy trên host: 127.0.0.1:8088.
FRONTEND_BIND=80

# true khi người dùng truy cập bằng HTTPS; false nếu mới kiểm thử qua HTTP/IP.
APP_COOKIE_SECURE=true

# Frontend production gọi API cùng origin qua /graduration nên có thể để trống.
# Nếu frontend ở origin khác, nhập danh sách phân cách bằng dấu phẩy.
# Ví dụ: https://doan.example.edu.vn,https://admin.example.edu.vn
APP_CORS_ALLOWED_ORIGINS=

# Giai đoạn đầu có thể dùng update. Chuyển sang validate khi đã quản lý migration riêng.
JPA_DDL_AUTO=update
