# Đổi toàn bộ giá trị mặc định này trước khi triển khai Internet.
MYSQL_DATABASE=graduration-managerment
MYSQL_ROOT_PASSWORD=change-this-mysql-password
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change-this-mongo-password
# Phải URL-encode ký tự đặc biệt trong mật khẩu (@ -> %40, # -> %23, ...).
MONGO_URI=mongodb://admin:change-this-mongo-password@mongodb:27017/graduration_managerment?authSource=admin

# Cổng public trên máy chủ.
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Bật true khi ứng dụng chạy sau HTTPS (cookie đăng nhập sẽ có Secure).
APP_COOKIE_SECURE=false

# Giữ update để Hibernate tự bổ sung thay đổi schema trong môi trường test.
# Production nên dùng validate sau khi đã quản lý migration riêng.
JPA_DDL_AUTO=update
